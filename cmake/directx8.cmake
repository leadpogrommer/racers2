# Consume the JSON emitted by tools/directx8.py for optional DX8 SDK/Wine setup.

if(NOT DEFINED LR2_DIRECTX8_CONFIG)
  set(_lr2_default_dx8 "$ENV{LR2_DIRECTX8_CONFIG}")
  if(NOT _lr2_default_dx8 AND EXISTS "${PROJECT_SOURCE_DIR}/build-dx8-config/directx8-config.json")
    set(_lr2_default_dx8 "${PROJECT_SOURCE_DIR}/build-dx8-config/directx8-config.json")
  endif()
  set(LR2_DIRECTX8_CONFIG "${_lr2_default_dx8}" CACHE FILEPATH "DirectX 8 configuration JSON")
endif()

function(_lr2_directx8_convert_path output path)
  file(TO_CMAKE_PATH "${path}" _path)
  if(WIN32 AND _path MATCHES "^/")
    # CMake may run on Windows while the JSON was generated by the Linux/Wine
    # helper. Wine exposes the host filesystem through its Z: drive.
    set(_path "Z:${_path}")
  endif()
  set(${output} "${_path}" PARENT_SCOPE)
endfunction()

function(_lr2_directx8_json_array output json key)
  string(JSON _length ERROR_VARIABLE _error LENGTH "${json}" "${key}")
  if(_error)
    message(FATAL_ERROR "DirectX config is missing array '${key}': ${_error}")
  endif()
  set(_values)
  if(_length GREATER 0)
    math(EXPR _last "${_length} - 1")
    foreach(_index RANGE 0 ${_last})
      string(JSON _value ERROR_VARIABLE _error GET "${json}" "${key}" ${_index})
      if(_error)
        message(FATAL_ERROR "Could not read DirectX config '${key}[${_index}]': ${_error}")
      endif()
      list(APPEND _values "${_value}")
    endforeach()
  endif()
  set(${output} "${_values}" PARENT_SCOPE)
endfunction()

function(_lr2_directx8_find_file output directory filename)
  file(GLOB _candidates LIST_DIRECTORIES FALSE "${directory}/*")
  string(TOLOWER "${filename}" _wanted)
  foreach(_candidate IN LISTS _candidates)
    get_filename_component(_name "${_candidate}" NAME)
    string(TOLOWER "${_name}" _name_lower)
    if("${_name_lower}" STREQUAL "${_wanted}")
      set(${output} "${_candidate}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${output} "" PARENT_SCOPE)
endfunction()

function(lr2_configure_directx8 target)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "lr2_configure_directx8: '${target}' is not a CMake target")
  endif()
  if(NOT LR2_DIRECTX8_CONFIG)
    return()
  endif()
  if(NOT EXISTS "${LR2_DIRECTX8_CONFIG}")
    message(FATAL_ERROR "DirectX config JSON not found: ${LR2_DIRECTX8_CONFIG}")
  endif()

  file(READ "${LR2_DIRECTX8_CONFIG}" _json)
  string(JSON _mode ERROR_VARIABLE _error GET "${_json}" mode)
  if(_error)
    message(FATAL_ERROR "Could not read DirectX config mode: ${_error}")
  endif()
  if(NOT _mode STREQUAL "wine" AND NOT _mode STREQUAL "sdk")
    message(FATAL_ERROR "Unsupported DirectX config mode '${_mode}'")
  endif()

  _lr2_directx8_json_array(_raw_includes "${_json}" include_dirs)
  _lr2_directx8_json_array(_raw_library_dirs "${_json}" library_dirs)
  _lr2_directx8_json_array(_defines "${_json}" defines)
  _lr2_directx8_json_array(_raw_libraries "${_json}" libraries)
  _lr2_directx8_json_array(_link_options "${_json}" link_options)

  set(_include_dirs)
  foreach(_directory IN LISTS _raw_includes)
    _lr2_directx8_convert_path(_directory "${_directory}")
    if(NOT IS_DIRECTORY "${_directory}")
      message(FATAL_ERROR "DirectX include directory is missing: ${_directory}")
    endif()
    list(APPEND _include_dirs "${_directory}")
  endforeach()

  foreach(_header d3d8.h dinput.h dsound.h)
    set(_found_header FALSE)
    foreach(_directory IN LISTS _include_dirs)
      _lr2_directx8_find_file(_header_path "${_directory}" "${_header}")
      if(_header_path)
        set(_found_header TRUE)
        break()
      endif()
    endforeach()
    if(NOT _found_header)
      message(FATAL_ERROR "DirectX config has no '${_header}' in its include directories")
    endif()
  endforeach()
  if(_mode STREQUAL "wine")
    foreach(_header d3d8caps.h d3d8types.h basetsd.h)
      set(_found_header FALSE)
      foreach(_directory IN LISTS _include_dirs)
        _lr2_directx8_find_file(_header_path "${_directory}" "${_header}")
        if(_header_path)
          set(_found_header TRUE)
          break()
        endif()
      endforeach()
      if(NOT _found_header)
        message(FATAL_ERROR "Wine DirectX config has no '${_header}' in its include directories")
      endif()
    endforeach()
    if(NOT "LR2_USE_WINE_DX8" IN_LIST _defines)
      message(FATAL_ERROR "Wine DirectX config must define LR2_USE_WINE_DX8")
    endif()
  endif()

  set(_library_dirs)
  foreach(_directory IN LISTS _raw_library_dirs)
    _lr2_directx8_convert_path(_directory "${_directory}")
    if(NOT IS_DIRECTORY "${_directory}")
      message(FATAL_ERROR "DirectX library directory is missing: ${_directory}")
    endif()
    list(APPEND _library_dirs "${_directory}")
  endforeach()

  set(_libraries)
  foreach(_library IN LISTS _raw_libraries)
    set(_resolved_library "")
    foreach(_directory IN LISTS _library_dirs)
      _lr2_directx8_find_file(_resolved_library "${_directory}" "${_library}")
      if(_resolved_library)
        break()
      endif()
    endforeach()
    if(NOT _resolved_library)
      message(FATAL_ERROR "DirectX import library '${_library}' is missing from configured library directories")
    endif()
    list(APPEND _libraries "${_resolved_library}")
  endforeach()

  # Match build.py: project /I paths precede the configured SDK directories.
  # Otherwise the SDK d3dx8.h shadows util/d3dx8.h and bypasses its VC6 bridge.
  target_include_directories("${target}" PRIVATE ${_include_dirs})
  target_compile_definitions("${target}" PRIVATE ${_defines})
  target_link_directories("${target}" PRIVATE ${_library_dirs})
  target_link_libraries("${target}" PRIVATE ${_libraries})
  target_link_options("${target}" PRIVATE ${_link_options})
endfunction()
